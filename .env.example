# ============================================================
# AgentLink 本地运行配置（复制为 .env 后按需填写）
#   Windows:  copy .env.example .env
#   Linux:    cp .env.example .env
# ============================================================

# ---- 必填：大模型（OpenAI 兼容，推荐 DeepSeek）----
LLM_PROVIDER=deepseek
LLM_API_KEY=sk-your-key-here
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# ---- 运行时（默认 commerce_v2 双路径）----
AGENTLINK_RUNTIME=v2
BUYER_CHAT_ENGINE=wit

# ---- 本地演示安全开关（不上平台证书也能跑通 HTTP）----
AIP_IDENTITY_BINDING=0
AIP_SSL_INSECURE=1
# 本地不连梧桐 Kafka；接平台后再改为 1
AMP_KAFKA_ENABLED=0

# ---- 可选：梧桐 / ACPs 平台（联调或参赛正式链再填）----
# ACPS_REGISTRY_URL=https://wt.ioa.pub/registry-server
# ACPS_CA_URL=https://wt.ioa.pub/ca-server
# ACPS_DISCOVERY_URL=https://wt.ioa.pub/discovery
# ACPS_DISCOVER_PATH=/acps-adp-v2/discover
# ADP_DISCOVER_CACHE_TTL=60
# AMP_KAFKA_ENABLED=1
# AMP_KAFKA_BOOTSTRAP=wt.ioa.pub:19092
# AMP_ACCESS_TOPIC=amp.access
# AMP_MESSAGE_TOPIC=amp.message
# AMP_HEARTBEAT_TOPIC=amp.heartbeat
# AMP_HEARTBEAT_ENABLED=1
# ACPS_MQ_HOST=wt.ioa.pub
# ACPS_MQ_PORT=5671
# ACPS_MQ_VHOST=acps
# ACPS_MQ_AUTH_URL=https://wt.ioa.pub/mq-auth
# ACPS_PUBLIC_ENDPOINT=
# AIP_PUBLIC_RPC_URL=

# ---- 平台发证后回填 AIC（本地可留空，使用 *-local-aic）----
# BUYER_A_AIC=
# BUYER_B_AIC=
# SUPPLIER_A_AIC=
# SUPPLIER_B_AIC=
# SUPPLIER_C_AIC=
# LOGISTICS_AIC=

# ---- mTLS 证书路径（平台 CA 下发后）----
# AIP_CLIENT_CERT=
# AIP_CLIENT_KEY=
# AIP_SERVER_CERT=
# AIP_SERVER_KEY=
# AIP_TRUST_BUNDLE=
# AIP_SSL_CERT_REQS=required
